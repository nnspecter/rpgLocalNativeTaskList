{
  "name": "rpgtasks",
  "version": "2.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "aab": "eas build --platform android --profile production",
    "apk": "eas build --platform android --profile preview",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@expo-google-fonts/rubik": "^0.4.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-vector-icons/material-design-icons": "^13.0.0",
    "@react-navigation/bottom-tabs": "^7.16.1",
    "@react-navigation/material-top-tabs": "^7.4.27",
    "@react-navigation/native": "^7.2.4",
    "@tanstack/react-query": "^5.96.1",
    "axios": "^1.14.0",
    "expo": "^55.0.24",
    "expo-font": "^55.0.7",
    "expo-localization": "^55.0.14",
    "expo-navigation-bar": "^55.0.13",
    "expo-splash-screen": "^55.0.21",
    "expo-status-bar": "~55.0.6",
    "i18n-js": "^4.5.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-native": "0.83.4",
    "react-native-android-widget": "^0.20.3",
    "react-native-circular-progress": "^1.4.1",
    "react-native-drax": "^1.1.0",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-infinite-wheel-picker": "^1.0.0",
    "react-native-pager-view": "^8.0.0",
    "react-native-paper": "^5.15.0",
    "react-native-reanimated": "^4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-tab-view": "^4.3.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "^0.8.3",
    "react-native-worklets-core": "^1.6.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "babel-plugin-module-resolver": "^5.0.3",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.0",
    "typescript": "~5.9.2"
  },
  "jest": {
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "babel-jest",
        {
          "configFile": "./babel.config.js"
        }
      ],
      "^.+\\.jsx?$": [
        "babel-jest",
        {
          "configFile": "./babel.config.js"
        }
      ]
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|react-native-paper|react-native-vector-icons|@react-native-async-storage/async-storage|react-native-worklets|react-native-worklets-core|react-native-gesture-handler|react-native-reanimated|react-native-safe-area-context|@react-native-vector-icons/.*|@react-native-picker/.*)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@assets/(.*)$": "<rootDir>/assets/$1"
    },
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "fakeTimers": {
      "enableGlobally": true
    }
  },
  "private": true
}
