{
  "name": "RPGTasks",
  "slug": "rpgtasks",
  "version": "2.0.0",
  "orientation": "portrait",
  "icon": "./assets/icon.png",
  "scheme": "rpgtasks",
  "userInterfaceStyle": "automatic",
  
  "ios": {
    "supportsTablet": true,
    "icon": "./assets/icon.png"
  },
  "android": {
    "adaptiveIcon": {
      "backgroundColor": "#E6F4FE",
      "foregroundImage": "./assets/android-icon-foreground.png",
      "backgroundImage": "./assets/android-icon-background.png",
      "monochromeImage": "./assets/android-icon-monochrome.png"
    },
    "predictiveBackGestureEnabled": false,
    "package": "com.nnspecter.rpgtasks"
    
  },
  "web": {
    "favicon": "./assets/favicon.png"
  },
  "plugins": [
    "expo-font",
    "expo-localization",
    [
      "expo-splash-screen",
      {
        "image": "./assets/splash-icon.png",
        "imageWidth": 200,
        "resizeMode": "contain",
        "backgroundColor": "#ffffff",
        "dark": {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#1C1B1F"
        }
      }
    ],
    [
      "react-native-android-widget",
      {
        "widgets": [
          {
            "name": "Streak2",
            "label": "Streak 2x2 widget",
            "minWidth": "110dp",
            "minHeight": "110dp",
            "maxWidth": "110dp",
            "maxHeight": "110dp",
            "targetCellWidth": 2,
            "targetCellHeight": 2,
            "resizeMode": "none",
            "description": "Streak and level widget",
            "previewImage": "./assets/icon.png",
            "updatePeriodMillis": 1800000
          },
          {
            "name": "Streak5",
            "label": "Streak 5x2 widget",
            "resizeMode": "horizontal",
            "minWidth": "320dp",
            "minHeight": "120dp",
            "targetCellWidth": 5,
            "targetCellHeight": 2,
            "description": "Streak and level widget",
            "previewImage": "./assets/widgets/fire.png",
            "updatePeriodMillis": 1800000
          }
        ]
      }
    ]
  ],
  "extra": {
    "eas": {
      "projectId": "a847d571-ee54-4822-87f2-b78e5fa5d6fb"
    }
  },
  "owner": "neokanzaki"
}
